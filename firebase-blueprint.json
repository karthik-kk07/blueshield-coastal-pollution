{
  "entities": {
    "User": {
      "title": "User",
      "description": "Registered user profile with role-based access control",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "format": "email", "maxLength": 128 },
        "role": {
          "type": "string",
          "enum": ["CITIZEN", "VOLUNTEER", "COORDINATOR", "CLEANUP_TEAM", "ADMIN", "RESEARCHER"]
        },
        "organization": { "type": "string", "maxLength": 128 },
        "displayName": { "type": "string", "maxLength": 100 },
        "badgeLevel": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "name", "email", "role", "createdAt"]
    },
    "Report": {
      "title": "Report",
      "description": "Coastal pollution incident reported by citizens, volunteers, or sensors",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "reportNumber": { "type": "string", "maxLength": 64 },
        "reportedBy": { "type": "string", "maxLength": 128 },
        "latitude": { "type": "number" },
        "longitude": { "type": "number" },
        "pollutionType": {
          "type": "string",
          "enum": [
            "Plastic",
            "Food Packaging",
            "Fishing Waste",
            "Glass",
            "Metal",
            "Organic Waste",
            "Drain Pollution",
            "Sewage / Wastewater",
            "Illegal Dumping",
            "Mixed Waste",
            "Other"
          ]
        },
        "severity": { "type": "string", "enum": ["LOW", "MODERATE", "HIGH", "CRITICAL"] },
        "description": { "type": "string", "maxLength": 5000 },
        "photoUrl": { "type": "string", "maxLength": 500000 },
        "status": {
          "type": "string",
          "enum": ["REPORTED", "VERIFIED", "ASSIGNED", "ACCEPTED", "IN_PROGRESS", "CLEANED", "VERIFIED_CLOSED", "REJECTED", "DUPLICATE", "NEEDS_MORE_INFO", "pending_verification", "field_verified", "dispatched", "in_progress", "remediated", "rejected"]
        },
        "assignedOrganization": { "type": "string", "maxLength": 128 },
        "assignedTo": { "type": "string", "maxLength": 128 },
        "assignedAt": { "type": "string", "maxLength": 64 },
        "acceptedAt": { "type": "string", "maxLength": 64 },
        "acceptedBy": { "type": "string", "maxLength": 128 },
        "afterPhotoUrl": { "type": "string", "maxLength": 500000 },
        "cleanedAt": { "type": "string", "maxLength": 64 },
        "closedAt": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 },
        "trackingCode": { "type": "string", "maxLength": 64 },
        "title": { "type": "string", "maxLength": 160 },
        "category": { "type": "string", "maxLength": 64 },
        "coastalZone": { "type": "string", "maxLength": 128 },
        "reporterId": { "type": "string", "maxLength": 128 }
      },
      "required": ["id", "reportNumber", "pollutionType", "severity", "status", "createdAt"]
    },
    "Assignment": {
      "title": "Assignment",
      "description": "Dispatch ticket assigning an incident to a response team or agency",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "reportId": { "type": "string", "maxLength": 128 },
        "assignedToOrganization": { "type": "string", "maxLength": 128 },
        "teamLead": { "type": "string", "maxLength": 100 },
        "priority": { "type": "string", "enum": ["standard", "urgent", "emergency"] },
        "status": { "type": "string", "enum": ["assigned", "acknowledged", "mobilized", "completed"] },
        "assignedAt": { "type": "string", "maxLength": 64 },
        "dueAt": { "type": "string", "maxLength": 64 },
        "notes": { "type": "string", "maxLength": 1000 }
      },
      "required": ["id", "reportId", "assignedToOrganization", "status", "assignedAt"]
    },
    "CleanupRecord": {
      "title": "CleanupRecord",
      "description": "Evidentiary record documenting physical waste remediation, before/after evidence, and disposal metrics",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "reportId": { "type": "string", "maxLength": 128 },
        "beforePhoto": { "type": "string", "maxLength": 500000 },
        "afterPhoto": { "type": "string", "maxLength": 500000 },
        "wasteWeight": { "type": "number" },
        "wasteCount": { "type": "number" },
        "areaCleaned": { "type": "string", "maxLength": 128 },
        "notes": { "type": "string", "maxLength": 3000 },
        "completedBy": { "type": "string", "maxLength": 128 },
        "completedAt": { "type": "string", "maxLength": 64 },
        "assignmentId": { "type": "string", "maxLength": 128 },
        "dryWeightKg": { "type": "number" },
        "volumeM3": { "type": "number" },
        "beforePhotoUrl": { "type": "string", "maxLength": 500000 },
        "afterPhotoUrl": { "type": "string", "maxLength": 500000 }
      },
      "required": ["id", "reportId", "afterPhoto", "completedBy", "completedAt"]
    },
    "Organization": {
      "title": "Organization",
      "description": "Municipal authority, marine agency, cleanup team, or accredited NGO partner",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 128 },
        "type": {
          "type": "string",
          "enum": ["MUNICIPAL", "NGO", "VOLUNTEER_GROUP", "CLEANUP_TEAM", "OTHER", "municipal", "port", "enforcement", "research", "ngo"]
        },
        "contactName": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "format": "email", "maxLength": 128 },
        "phone": { "type": "string", "maxLength": 64 },
        "coverageArea": { "type": "string", "maxLength": 256 },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "name", "type", "active"]
    },
    "HistoricalCleanup": {
      "title": "HistoricalCleanup",
      "description": "Historical beach cleanup audit and longitudinal metric records",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "cleanupId": { "type": "string", "maxLength": 128 },
        "zone": { "type": "string", "maxLength": 128 },
        "beachName": { "type": "string", "maxLength": 128 },
        "date": { "type": "string", "maxLength": 64 },
        "totalWasteKg": { "type": "number" },
        "plasticWasteKg": { "type": "number" },
        "fishingGearKg": { "type": "number" },
        "glassMetalKg": { "type": "number" },
        "organicKg": { "type": "number" },
        "bagsCount": { "type": "number" },
        "volunteerCount": { "type": "number" },
        "durationHours": { "type": "number" },
        "distanceKm": { "type": "number" },
        "latitude": { "type": "number" },
        "longitude": { "type": "number" },
        "organization": { "type": "string", "maxLength": 128 },
        "predominantCategory": { "type": "string", "maxLength": 64 },
        "tideCondition": { "type": "string", "maxLength": 64 },
        "weatherCondition": { "type": "string", "maxLength": 64 },
        "photoUrl": { "type": "string", "maxLength": 500000 },
        "notes": { "type": "string", "maxLength": 3000 },
        "dataSource": {
          "type": "string",
          "enum": ["REAL_HISTORICAL", "DEMO"]
        },
        "importedAt": { "type": "string", "maxLength": 64 },
        "importedBy": { "type": "string", "maxLength": 128 }
      },
      "required": ["id", "zone", "date", "totalWasteKg", "dataSource"]
    },
    "ActivityLog": {
      "title": "ActivityLog",
      "description": "Audit trail log tracking platform state transitions and user actions",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "actorId": { "type": "string", "maxLength": 128 },
        "actorName": { "type": "string", "maxLength": 100 },
        "actorRole": { "type": "string", "maxLength": 64 },
        "action": { "type": "string", "maxLength": 128 },
        "entityType": { "type": "string", "maxLength": 64 },
        "entityId": { "type": "string", "maxLength": 128 },
        "timestamp": { "type": "string", "maxLength": 64 },
        "metadata": { "type": "string", "maxLength": 1000 }
      },
      "required": ["id", "actorId", "action", "timestamp"]
    },
    "EntryPoint": {
      "title": "EntryPoint",
      "description": "Potential coastal pollution entry point (open drain, canal, stormwater or dumping point)",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "trackingCode": { "type": "string", "maxLength": 64 },
        "category": {
          "type": "string",
          "enum": ["Open Drain", "Stormwater Outlet", "Canal", "Wastewater Outlet", "Dumping Point", "Other"]
        },
        "severity": { "type": "string", "enum": ["LOW", "MODERATE", "HIGH", "CRITICAL"] },
        "status": {
          "type": "string",
          "enum": ["REPORTED", "VERIFIED", "ASSIGNED", "RESOLVED", "VERIFIED_CLOSED"]
        },
        "locationName": { "type": "string", "maxLength": 200 },
        "coastalZone": { "type": "string", "maxLength": 128 },
        "latitude": { "type": "number" },
        "longitude": { "type": "number" },
        "description": { "type": "string", "maxLength": 5000 },
        "photoUrl": { "type": "string", "maxLength": 500000 },
        "reportedBy": { "type": "string", "maxLength": 128 },
        "reportedAt": { "type": "string", "maxLength": 64 },
        "assignedOrganization": { "type": "string", "maxLength": 128 }
      },
      "required": ["id", "trackingCode", "category", "severity", "status", "locationName", "latitude", "longitude", "reportedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles and RBAC role assignments"
    },
    "/reports/{reportId}": {
      "schema": "Report",
      "description": "Citizen and sensor coastal pollution incident reports"
    },
    "/assignments/{assignmentId}": {
      "schema": "Assignment",
      "description": "Jurisdictional cleanup dispatch assignments"
    },
    "/cleanup_records/{cleanupId}": {
      "schema": "CleanupRecord",
      "description": "Field evidence and dry weight metrics of completed cleanups"
    },
    "/organizations/{orgId}": {
      "schema": "Organization",
      "description": "Authorized municipal and marine partner agencies"
    },
    "/historical_cleanups/{cleanupId}": {
      "schema": "HistoricalCleanup",
      "description": "Historical remediation dataset for longitudinal intelligence"
    },
    "/activity_logs/{logId}": {
      "schema": "ActivityLog",
      "description": "Immutable security and operational audit trail"
    },
    "/entry_points/{entryPointId}": {
      "schema": "EntryPoint",
      "description": "Hydrological inflow outfalls, canals, and dumping point monitoring records"
    }
  }
}
